# Grafika Scheduling — Environment Variables

# ===== ML Service (LangChain / OpenAI) =====
# Dapatkan API key di https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===== Backend (Go) =====
# Koneksi PostgreSQL, ubah user/password/host sesuai lokal
DATABASE_URL=postgres://grafika:grafika_dev@localhost:5432/grafika?sslmode=disable

# URL service ML (default sudah benar untuk local dev)
ML_SERVICE_URL=http://localhost:8000

# Port backend server
SERVER_PORT=8080

# ===== Frontend (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
